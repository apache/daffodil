      Purpose: This test demonstrates that hidden groups can contain a choice.
  -->

  <tdml:parserTestCase name="hiddenGroupChoice2" root="e"
                       model="hiddenGroupChoice" description="Section 14 - Hidden Groups - DFDL-14-042R"
                       roundTrip="twoPass">
    <tdml:document>
