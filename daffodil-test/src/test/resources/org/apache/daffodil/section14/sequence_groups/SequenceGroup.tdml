      </xs:sequence>
    </xs:group>

    <xs:element name="e" dfdl:lengthKind="delimited">
      <xs:complexType>
        <xs:sequence dfdl:separator=",">
          <xs:sequence dfdl:hiddenGroupRef="ex:hg" />
          <xs:element name="g" type="xs:int" />
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

