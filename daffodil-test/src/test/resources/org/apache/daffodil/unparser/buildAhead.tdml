  <!-- A dynamic dfdl:terminator expression referencing a preceding array's count: navigation-only, resolvable directly against the tree. -->
  <tdml:defineSchema name="s_dynamicTerminatorReferencingArrayCount" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:sequence>
            <xs:element name="int" type="xs:int" minOccurs="0" maxOccurs="2"
              dfdl:lengthKind="explicit"
              dfdl:length="1"/>
            <xs:element name="term" type="xs:string"
              dfdl:lengthKind="explicit"
              dfdl:length="0"
              dfdl:terminator="{ if (fn:count(../int) gt 1) then 'x' else 'y' }"/>
          </xs:sequence>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="dynamicTerminatorReferencingArrayCount" root="row" model="s_dynamicTerminatorReferencingArrayCount">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row><term></term></ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>y</tdml:document>
  </tdml:unparserTestCase>

  <!-- An IVC field (no unparse effect) referencing fn:exists over a nested array: exercises ordinary navigation past a nested array. -->
  <tdml:defineSchema name="s_ivcExistsOverNestedArray" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:sequence dfdl:separator="|">
            <xs:element name="seq">
              <xs:complexType>
                <xs:sequence dfdl:separator=",">
                  <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="10"
                    dfdl:lengthKind="delimited"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="exists" type="xs:boolean"
              dfdl:inputValueCalc="{ fn:exists(../seq/item) }"/>
          </xs:sequence>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="ivcExistsOverNestedArray" root="row" model="s_ivcExistsOverNestedArray">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row>
          <seq>
            <item>1</item>
            <item>2</item>
            <item>3</item>
            <item>4</item>
          </seq>
          <exists>true</exists>
        </ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>1,2,3,4</tdml:document>
  </tdml:unparserTestCase>

  <!-- Aggressive throttling forces every "len" suspension to be retried repeatedly; guards against re-running an already-resolved one. -->
  <tdml:defineSchema name="s_manyValueLengthForwardReferencesThrottled" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"/>
    <xs:element name="root" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="record" maxOccurs="unbounded">
            <xs:complexType>
              <xs:sequence dfdl:separator="|">
                <xs:element name="len" type="xs:int"
                  dfdl:lengthKind="explicit"
                  dfdl:length="4"
                  dfdl:outputValueCalc="{ dfdl:valueLength(../data, 'bytes') }"/>
                <xs:element name="data" type="xs:string" dfdl:lengthKind="delimited"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="manyValueLengthForwardReferencesThrottled" root="root" model="s_manyValueLengthForwardReferencesThrottled" config="cfg2">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:root>
          <record><data>value0</data></record>
          <record><data>value1</data></record>
          <record><data>value2</data></record>
          <record><data>value3</data></record>
          <record><data>value4</data></record>
          <record><data>value5</data></record>
          <record><data>value6</data></record>
          <record><data>value7</data></record>
        </ex:root>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>6   |value06   |value16   |value26   |value36   |value46   |value56   |value66   |value7</tdml:document>
  </tdml:unparserTestCase>

  <!-- A repeating NVI scope with a valueLength OVC reading it, letting build race many iterations ahead: guards against a stale iteration's value. -->
  <tdml:defineSchema name="s_nviScopedVariableWithValueLengthOVC" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"/>
    <dfdl:defineVariable name="runningVar" type="xs:int"/>
    <xs:element name="root" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="record" maxOccurs="unbounded">
            <xs:complexType>
              <xs:sequence dfdl:separator="|">
                <xs:annotation>
                  <xs:appinfo source="http://www.ogf.org/dfdl/">
                    <dfdl:newVariableInstance ref="ex:runningVar" defaultValue="0"/>
                  </xs:appinfo>
                </xs:annotation>
                <xs:element name="idx" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="2">
                  <xs:annotation>
                    <xs:appinfo source="http://www.ogf.org/dfdl/">
                      <dfdl:setVariable ref="ex:runningVar" value="{ . }"/>
                    </xs:appinfo>
                  </xs:annotation>
                </xs:element>
                <xs:element name="len" type="xs:int"
                  dfdl:lengthKind="explicit"
                  dfdl:length="4"
                  dfdl:outputValueCalc="{ $ex:runningVar + dfdl:valueLength(../data, 'bytes') }"/>
                <xs:element name="data" type="xs:string" dfdl:lengthKind="delimited"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="nviScopedVariableWithValueLengthOVC" root="root" model="s_nviScopedVariableWithValueLengthOVC" config="cfg3">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:root>
          <record><idx>00</idx><data>value0</data></record>
          <record><idx>01</idx><data>value1</data></record>
          <record><idx>02</idx><data>value2</data></record>
          <record><idx>03</idx><data>value3</data></record>
          <record><idx>04</idx><data>value4</data></record>
          <record><idx>05</idx><data>value5</data></record>
          <record><idx>06</idx><data>value6</data></record>
          <record><idx>07</idx><data>value7</data></record>
        </ex:root>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>0 |6   |value01 |7   |value12 |8   |value23 |9   |value34 |10  |value45 |11  |value56 |12  |value67 |13  |value7</tdml:document>
  </tdml:unparserTestCase>

  <!-- Simpler variant of the repeating-NVI test above: a single (non-repeating) scope, as a distinct data point. -->
  <tdml:defineSchema name="s_singleNviScopedVariableWithValueLengthOVC" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"/>
    <dfdl:defineVariable name="runningVar" type="xs:int"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence dfdl:separator="|">
          <xs:annotation>
            <xs:appinfo source="http://www.ogf.org/dfdl/">
              <dfdl:newVariableInstance ref="ex:runningVar" defaultValue="0"/>
            </xs:appinfo>
          </xs:annotation>
          <xs:element name="idx" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="2">
            <xs:annotation>
              <xs:appinfo source="http://www.ogf.org/dfdl/">
                <dfdl:setVariable ref="ex:runningVar" value="{ . }"/>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="len" type="xs:int"
            dfdl:lengthKind="explicit"
            dfdl:length="4"
            dfdl:outputValueCalc="{ $ex:runningVar + dfdl:valueLength(../data, 'bytes') }"/>
          <xs:element name="data" type="xs:string" dfdl:lengthKind="delimited"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="singleNviScopedVariableWithValueLengthOVC" root="row" model="s_singleNviScopedVariableWithValueLengthOVC">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row>
          <idx>42</idx>
          <data>hello</data>
        </ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>42|47  |hello</tdml:document>
  </tdml:unparserTestCase>

  <!-- Regression guard for NVI-scope setVariable resolution: no forward OVC or separator, the minimal shape that exposes the race. -->
  <tdml:defineSchema name="s_nviScopedSetVariableWithNoForwardReference" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"/>
    <dfdl:defineVariable name="runningVar" type="xs:int" external="true"/>
    <xs:element name="root" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="record" maxOccurs="unbounded">
            <xs:complexType>
              <xs:sequence>
                <xs:annotation>
                  <xs:appinfo source="http://www.ogf.org/dfdl/">
                    <dfdl:newVariableInstance ref="ex:runningVar" defaultValue="0"/>
                  </xs:appinfo>
                </xs:annotation>
                <xs:element name="idx" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="2">
                  <xs:annotation>
                    <xs:appinfo source="http://www.ogf.org/dfdl/">
                      <dfdl:setVariable ref="ex:runningVar" value="{ . }"/>
                    </xs:appinfo>
                  </xs:annotation>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="summary" type="xs:int"
            dfdl:lengthKind="explicit"
            dfdl:length="4"
            dfdl:outputValueCalc="{ $ex:runningVar }"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="nviScopedSetVariableWithNoForwardReference" root="root" model="s_nviScopedSetVariableWithNoForwardReference" config="cfg4">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:root>
          <record><idx>00</idx></record>
          <record><idx>01</idx></record>
          <record><idx>02</idx></record>
          <record><idx>03</idx></record>
          <record><idx>04</idx></record>
          <record><idx>05</idx></record>
          <record><idx>06</idx></record>
          <record><idx>07</idx></record>
        </ex:root>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>
      <tdml:documentPart type="byte">30 20 31 20 32 20 33 20 34 20 35 20 36 20 37 20 2D 31 20 20</tdml:documentPart>
    </tdml:document>
  </tdml:unparserTestCase>

  <!-- A variable-length dfdl:length expression inside a separated sequence must also call computeTargetLength from unparse's dispatch. -->
  <tdml:defineSchema name="s_delimitedVariableLengthExpression" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"
      textNumberJustification="right"
      textNumberPadCharacter="0"
      textPadKind="padChar"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:sequence dfdl:separator="|">
            <xs:element name="lenField" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="2"/>
            <xs:element name="content" type="xs:string"
              dfdl:lengthKind="explicit"
              dfdl:length="{ xs:int(../lenField) }"/>
          </xs:sequence>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="delimitedVariableLengthExpression" root="row" model="s_delimitedVariableLengthExpression">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row>
          <lenField>5</lenField>
          <content>hello</content>
        </ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>05|hello</tdml:document>
  </tdml:unparserTestCase>

  <!-- Same dispatch path as the test above, but for a complex element whose expression-based dfdl:length wraps a whole group's content chain. -->
  <tdml:defineSchema name="s_delimitedComplexVariableLengthExpression" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"
      textNumberJustification="right"
      textNumberPadCharacter="0"
      textPadKind="padChar"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:sequence dfdl:separator="|">
            <xs:element name="lenField" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="2"/>
            <xs:element name="wrapper" dfdl:lengthKind="explicit" dfdl:length="{ xs:int(../lenField) }">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="a" type="xs:string" dfdl:lengthKind="explicit" dfdl:length="3"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="delimitedComplexVariableLengthExpression" root="row" model="s_delimitedComplexVariableLengthExpression">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row>
          <lenField>3</lenField>
          <wrapper><a>xyz</a></wrapper>
        </ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>03|xyz</tdml:document>
  </tdml:unparserTestCase>

  <!-- A schema where every OVC is content-length-dependent (never resolvable early) still builds ahead when the tunable is on, and unparses the same. -->
  <tdml:defineSchema name="s_purelyContentLengthOVC" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"
      textNumberJustification="right"
      textNumberPadCharacter="0"
      textPadKind="padChar"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="len" type="xs:int"
            dfdl:lengthKind="explicit"
            dfdl:length="2"
            dfdl:outputValueCalc="{ dfdl:valueLength(../data, 'bytes') }"/>
          <xs:element name="data" type="xs:string" dfdl:lengthKind="explicit" dfdl:length="3"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="purelyContentLengthOVC" root="row" model="s_purelyContentLengthOVC">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row><data>xyz</data></ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>03xyz</tdml:document>
  </tdml:unparserTestCase>

  <!-- A schema mixing a resolvable OVC with an unrelated content-length-dependent one must still use the build ahead path. -->
  <tdml:defineSchema name="s_mixedResolvableAndContentLengthOVC" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"
      textNumberJustification="right"
      textNumberPadCharacter="0"
      textPadKind="padChar"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="computed" type="xs:int"
            dfdl:lengthKind="explicit"
            dfdl:length="3"
            dfdl:outputValueCalc="{ ../actual + 1 }"/>
          <xs:element name="actual" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="3"/>
          <xs:element name="len" type="xs:int"
            dfdl:lengthKind="explicit"
            dfdl:length="2"
            dfdl:outputValueCalc="{ dfdl:valueLength(../data, 'bytes') }"/>
          <xs:element name="data" type="xs:string" dfdl:lengthKind="explicit" dfdl:length="3"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="mixedResolvableAndContentLengthOVC" root="row" model="s_mixedResolvableAndContentLengthOVC">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row>
          <actual>005</actual>
          <data>xyz</data>
        </ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>00600503xyz</tdml:document>
  </tdml:unparserTestCase>

  <!-- Event driven unparse reports where in the data an infoset mismatch happened. Build ahead runs ahead of the output, so it has no location to report. -->
  <tdml:defineSchema name="s_infosetMismatchLocation" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat"
      encoding="ascii"
      lengthUnits="bytes"
      textNumberJustification="right"
      textNumberPadCharacter="0"
      textPadKind="padChar"/>
    <xs:element name="row" dfdl:lengthKind="implicit">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="a" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="3"/>
          <xs:element name="b" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="3"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="eventDrivenInfosetMismatchReportsDataLocation" root="row" model="s_infosetMismatchLocation" config="cfgEventDriven">
    <tdml:infoset>
      <tdml:dfdlInfoset xmlns:ex="http://example.com">
        <ex:row><a>001</a><c>002</c></ex:row>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:errors>
      <tdml:error>Expected element start event for</tdml:error>
      <tdml:error>Data location was preceding byte</tdml:error>
    </tdml:errors>
  </tdml:unparserTestCase>

</tdml:testSuite>
