<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/"
           xmlns:dfdlx="http://www.ogf.org/dfdl/dfdl-1.0/extensions"
           targetNamespace="http://example.com/dcu"
           xmlns:ex="http://example.com/dcu"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:appinfo source="http://www.ogf.org/dfdl/">
      <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"
                   bitOrder="leastSignificantBitFirst" byteOrder="littleEndian"
                   encoding="ASCII"/>

      <!-- Same codes as the predefined X-DFDL-6-BIT-DFI-264-DUI-001 charset,
           written using DFDL Character Entities (%#xHH;) for the characters
           that cannot be written directly in the schema. -->
      <dfdlx:defineCharset name="BitsCharset6BitDFI408DUI505"
                           bitWidthOfACodeUnit="6"
                           decodeString="%#x20;123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;%#xFFFD;0"
                           replacementCharCode="0x0"
                           requiredBitOrder="leastSignificantBitFirst"/>

      <!-- A 6 bit charset where code i maps to the US-ASCII character i + 0x20
           (i.e. the 64 characters from U+0020 space through U+005F
           underscore). Uses the default requiredBitOrder
           (mostSignificantBitFirst) and mandatoryBitAlignment (1). -->
      <dfdlx:defineCharset name="UserASCII6BitMSB"
                           bitWidthOfACodeUnit="6"
                           replacementCharCode="0x0"
                           decodeString=" !&quot;#$%#x25;&amp;'()*+,-./0123456789:;&lt;=&gt;?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_"/>
    </xs:appinfo>
  </xs:annotation>

  <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>

  <xs:element name="sixBitUser" type="xs:string"
              dfdl:encoding="BitsCharset6BitDFI408DUI505"/>

  <xs:element name="ascii6BitUser" type="xs:string" dfdl:length="4"
              dfdl:lengthKind="explicit" dfdl:lengthUnits="characters"
              dfdl:bitOrder="mostSignificantBitFirst"
              dfdl:encoding="UserASCII6BitMSB"/>

</xs:schema>
