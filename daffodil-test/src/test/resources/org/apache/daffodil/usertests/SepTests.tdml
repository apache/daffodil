  <tdml:defineSchema name="s21" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        lengthKind="delimited"
        separator=","
        separatorPosition="infix"
        separatorSuppressionPolicy="trailingEmptyStrict"
    />

    <xs:element name="twoOptional">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="a" type="xs:int" minOccurs="0"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="requiredOptional">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="a" type="xs:string"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:defineSchema name="s22" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        lengthKind="delimited"
        separator=","
        separatorPosition="infix"
        separatorSuppressionPolicy="trailingEmpty"
    />

    <xs:element name="calculatedSibling">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="a" type="xs:int" minOccurs="0" maxOccurs="3"/>
          <xs:element name="calculated" type="xs:string" dfdl:inputValueCalc="{ 'k' }"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_ssp_strict_19" root="twoOptional" model="s21"
                       description="trailingEmptyStrict, infix: an empty first optional followed by a present one is not trailing, so it parses.">
    <tdml:document>,2</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:twoOptional xmlns:ex="http://example.com">
