  <tdml:parserTestCase name="test_sep_ssp_never_15" root="complex" model="s16"
                       implementations="daffodil"
                       description="never, complex elements: an empty middle occurrence that keeps its separator parses, with the middle element absent.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1//3%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:complex xmlns:ex="http://example.com">
          <one><value>1</value></one>
          <three><value>3</value></three>
        </ex:complex>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <!--
    Complex-typed analog of never_14: 'two' has no separator of its own in
    this data, so separatorSuppressionPolicy='never' must reject it, same as
    never_14.
  -->
  <tdml:parserTestCase name="test_sep_ssp_never_16" root="complex" model="s16"
                       implementations="daffodil"
                       description="never, complex elements: omitting a non-trailing empty occurrence together with its separator is rejected, since every occurrence is required.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/3%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>separatorSuppressionPolicy</tdml:error>
      <tdml:error>never</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s17" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        emptyValueDelimiterPolicy="none"
        lengthKind="delimited"
        separatorPosition="infix"
        separatorSuppressionPolicy="anyEmpty"
    />

    <xs:element name="simple">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix" dfdl:terminator="%NL;">
            <xs:element name="one" type="xs:string"  minOccurs="0"/>
            <xs:element name="two" type="xs:string" minOccurs="0">
              <xs:annotation>
                <xs:appinfo source="http://www.ogf.org/dfdl/">
                  <dfdl:discriminator test="{(. eq '') or (. eq '2')}"/>
                </xs:appinfo>
              </xs:annotation>
            </xs:element>
            <xs:element name="three" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="complex">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix" dfdl:terminator="%NL;">
            <xs:element name="one" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="two" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string">
                    <xs:annotation>
                      <xs:appinfo source="http://www.ogf.org/dfdl/">
                        <dfdl:discriminator test="{(. eq '') or (. eq '2')}"/>
                      </xs:appinfo>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="three" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="simple2">
      <xs:complexType>
        <xs:sequence dfdl:separator="%NL; %SP;" dfdl:separatorPosition="infix">
            <xs:element name="one" type="xs:string"  minOccurs="0" dfdl:initiator="1)%WSP*; 1)"/>
            <xs:element name="two" type="xs:string" minOccurs="0" dfdl:initiator="2)%WSP*; 2)"/>
            <xs:element name="three" type="xs:string" minOccurs="0" dfdl:initiator="3)%WSP*; 3)"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="complex2">
      <xs:complexType>
        <xs:sequence dfdl:separator="%NL; %SP;" dfdl:separatorPosition="infix">
            <xs:element name="one" minOccurs="0" dfdl:initiator="1)%WSP*; 1)">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="two" minOccurs="0" dfdl:initiator="2)%WSP*; 2)">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="three" minOccurs="0" dfdl:initiator="3)%WSP*; 3)">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>


  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_ssp_any_1" root="simple" model="s17"
                       implementations="daffodil"
                       description="anyEmpty, simple elements: a discriminated empty middle occurrence is kept as an empty element.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1//3%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:simple xmlns:ex="http://example.com">
          <one>1</one>
          <two></two>
          <three>3</three>
        </ex:simple>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

