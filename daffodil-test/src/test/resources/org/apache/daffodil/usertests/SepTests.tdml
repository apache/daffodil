      <tdml:error>Non-trailing zero length occurrences</tdml:error>
      <tdml:error>may not be omitted</tdml:error>
      <tdml:error>separatorSuppressionPolicy='trailingEmpty'</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_trailing_3" root="complex" model="s15"
