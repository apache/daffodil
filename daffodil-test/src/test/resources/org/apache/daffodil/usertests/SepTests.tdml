      <tdml:error>trailingEmptyStrict</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_9" root="postfixOptional" model="s19"
                       description="trailingEmptyStrict, postfix, all-optional elements: a present optional first element followed by an optional second element omitted along with its separator parses.">
    <tdml:document>1;</tdml:document>
