  <tdml:parserTestCase name="test_sep_ssp_never_14" root="simple" model="s16"
                       implementations="daffodil"
                       description="never, simple elements: omitting a non-trailing empty occurrence together with its separator is rejected, since every occurrence is required.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/3%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:errors>
