    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:postfix xmlns:ex="http://example.com">
          <a>1</a>
          <b>2</b>
        </ex:postfix>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_7" root="postfix" model="s19"
                       description="trailingEmptyStrict, postfix: a trailing empty optional that still has its separator is rejected.">
    <tdml:document>1;;</tdml:document>
