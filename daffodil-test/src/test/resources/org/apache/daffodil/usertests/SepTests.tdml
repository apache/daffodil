  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_14" root="trailing" model="s20"
                       description="trailingEmpty, postfix: a trailing empty optional with its separator is allowed.">
    <tdml:document>1;;</tdml:document>
