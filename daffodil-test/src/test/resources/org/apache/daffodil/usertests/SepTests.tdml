  <tdml:defineSchema name="s18" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        emptyValueDelimiterPolicy="none"
        lengthKind="delimited"
        separatorPosition="infix"
        separatorSuppressionPolicy="trailingEmptyStrict"
    />

    <xs:element name="simple">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix" dfdl:terminator="%NL;">
            <xs:element name="one" type="xs:string"  minOccurs="0"/>
            <xs:element name="two" type="xs:string" minOccurs="0"/>
            <xs:element name="three" type="xs:string" minOccurs="0">
              <xs:annotation>
                <xs:appinfo source="http://www.ogf.org/dfdl/">
                  <dfdl:discriminator test="{. eq '3'}"/>
                </xs:appinfo>
              </xs:annotation>
            </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="complex">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix" dfdl:terminator="%NL;">
            <xs:element name="one" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="two" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="three" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string">
                    <xs:annotation>
                      <xs:appinfo source="http://www.ogf.org/dfdl/">
                        <dfdl:discriminator test="{. eq '3'}"/>
                      </xs:appinfo>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_ssp_strict_1" root="simple" model="s18"
                       implementations="daffodil"
                       description="trailingEmptyStrict, simple elements: data with no trailing empty occurrence parses.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/2%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:simple xmlns:ex="http://example.com">
          <one>1</one>
          <two>2</two>
        </ex:simple>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_2" root="simple" model="s18"
                       implementations="daffodil"
                       description="trailingEmptyStrict, simple elements: a trailing empty occurrence with its separator is rejected.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/2/%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>separatorSuppressionPolicy</tdml:error>
      <tdml:error>trailingEmptyStrict</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_3" root="complex" model="s18"
                       implementations="daffodil"
                       description="trailingEmptyStrict, complex elements: data with no trailing empty occurrence parses.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/2%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:complex xmlns:ex="http://example.com">
          <one><value>1</value></one>
          <two><value>2</value></two>
        </ex:complex>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_4" root="complex" model="s18"
                       implementations="daffodil"
                       description="trailingEmptyStrict, complex elements: a trailing empty occurrence with its separator is rejected.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/2/%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>separatorSuppressionPolicy</tdml:error>
      <tdml:error>trailingEmptyStrict</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s19" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        lengthKind="delimited"
        separator=";"
        separatorSuppressionPolicy="trailingEmptyStrict"
    />

    <xs:element name="postfix">
      <xs:complexType>
        <xs:sequence dfdl:separatorPosition="postfix">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="postfixOptional">
      <xs:complexType>
        <xs:sequence dfdl:separatorPosition="postfix">
          <xs:element name="a" type="xs:int" minOccurs="0"/>
          <xs:element name="b" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="prefix">
      <xs:complexType>
        <xs:sequence dfdl:separatorPosition="prefix">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="infix">
      <xs:complexType>
        <xs:sequence dfdl:separatorPosition="infix">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:defineSchema name="s20" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        lengthKind="delimited"
        separator=";"
        separatorPosition="postfix"
    />

    <xs:element name="trailing">
      <xs:complexType>
        <xs:sequence dfdl:separatorSuppressionPolicy="trailingEmpty">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="anyEmpty">
      <xs:complexType>
        <xs:sequence dfdl:separatorSuppressionPolicy="anyEmpty">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="never">
      <xs:complexType>
        <xs:sequence dfdl:separatorSuppressionPolicy="never">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="b" type="xs:int" minOccurs="0"/>
          <xs:element name="c" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_ssp_strict_5" root="postfix" model="s19"
                       description="trailingEmptyStrict, postfix: a required first element followed by trailing optionals omitted along with their separators parses.">
    <tdml:document>1;</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:postfix xmlns:ex="http://example.com">
