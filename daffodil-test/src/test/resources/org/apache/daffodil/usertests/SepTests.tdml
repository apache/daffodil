      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_20" root="twoOptional" model="s21"
                       description="trailingEmptyStrict, infix: no data for two optionals parses, since nothing is trailing with a separator.">
    <tdml:document></tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:twoOptional xmlns:ex="http://example.com"/>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_21" root="requiredOptional" model="s21"
                       description="trailingEmptyStrict, infix: an empty required string with an omitted optional parses.">
    <tdml:document></tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:requiredOptional xmlns:ex="http://example.com">
          <a></a>
        </ex:requiredOptional>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_22" root="requiredOptional" model="s21"
                       description="trailingEmptyStrict, infix: an empty required string followed by a present optional parses.">
    <tdml:document>,2</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:requiredOptional xmlns:ex="http://example.com">
          <a></a>
          <b>2</b>
        </ex:requiredOptional>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_trailing_5" root="calculatedSibling" model="s22"
                       description="trailingEmpty, infix: a bounded array that ends normally before a calculated element is not mistaken for a non-trailing empty occurrence omitted with its separator.">
    <tdml:document>1,2,x</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:calculatedSibling xmlns:ex="http://example.com">
          <a>1</a>
          <a>2</a>
          <calculated>k</calculated>
          <c>x</c>
        </ex:calculatedSibling>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s23" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        lengthKind="delimited"
        separator="ABC"
        separatorPosition="infix"
        separatorSuppressionPolicy="never"
    />

    <xs:element name="staleDelimiter">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="c">
            <xs:complexType>
              <xs:sequence dfdl:separator="">
                <xs:element name="s" type="xs:string"/>
                <xs:element name="i" type="xs:int" dfdl:lengthKind="explicit" dfdl:length="2"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="d" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_probe_stale_delimiter_1" root="staleDelimiter" model="s23"
                       description="A failed nested explicit-length field gives a clean parse error and does not reuse a delimiter result left by an earlier scan.">
    <tdml:document>xABC</tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>Unable to parse xs:int from text</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s24" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        lengthKind="delimited"
    />

    <xs:group name="initiatedItem">
      <xs:sequence>
        <xs:element name="x" type="xs:string" dfdl:initiator="X:"/>
      </xs:sequence>
    </xs:group>

    <xs:element name="postfixComplexArray">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="postfix" dfdl:separatorSuppressionPolicy="trailingEmpty" dfdl:terminator=";">
          <xs:element name="a" type="xs:string"/>
          <xs:element name="c" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType>
              <xs:group ref="initiatedItem"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="postfixComplexOptional">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="postfix" dfdl:separatorSuppressionPolicy="trailingEmptyStrict" dfdl:terminator="!">
          <xs:element name="h" type="xs:string"/>
          <xs:element name="c" minOccurs="0">
            <xs:complexType>
              <xs:group ref="initiatedItem"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_probe_postfix_complex_1" root="postfixComplexArray" model="s24"
                       description="Postfix separator, unbounded array of complex items before a terminator: the failed last attempt ends the array instead of looping.">
    <tdml:document>1,X:a,X:b,;</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:postfixComplexArray xmlns:ex="http://example.com">
          <a>1</a>
          <c><x>a</x></c>
          <c><x>b</x></c>
        </ex:postfixComplexArray>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_probe_postfix_complex_2" root="postfixComplexOptional" model="s24"
                       description="trailingEmptyStrict, postfix: an optional complex element omitted along with its separator before a terminator parses; the terminator is not mistaken for an empty occurrence of the element.">
    <tdml:document>h,!</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:postfixComplexOptional xmlns:ex="http://example.com">
          <h>h</h>
        </ex:postfixComplexOptional>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s25" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:element name="rewind">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="infix"
                     dfdl:separatorSuppressionPolicy="anyEmpty">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="u" minOccurs="0" dfdl:lengthKind="implicit">
            <xs:complexType>
              <xs:sequence dfdl:separator=";" dfdl:separatorPosition="infix">
                <xs:element name="c" dfdl:lengthKind="delimited">
                  <xs:complexType>
                    <xs:sequence dfdl:separator=":" dfdl:separatorPosition="infix">
                      <xs:element name="p" type="xs:int"/>
                      <xs:element name="q" type="xs:int"/>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="w" type="xs:int"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:defineSchema name="s26" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:group name="initiatedItem">
      <xs:sequence>
        <xs:element name="x" type="xs:string" dfdl:initiator="X:"/>
      </xs:sequence>
    </xs:group>

    <xs:element name="endOfDataArray">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="infix"
                     dfdl:separatorSuppressionPolicy="trailingEmpty">
          <xs:element name="a" type="xs:int"/>
          <xs:element name="c" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType>
              <xs:group ref="initiatedItem"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:defineSchema name="s27" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:element name="encodingScope">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="infix"
                     dfdl:separatorSuppressionPolicy="trailingEmpty">
          <xs:element name="enc" type="xs:string"/>
          <xs:element name="a" type="xs:int"/>
          <xs:element name="d" minOccurs="0" dfdl:encoding="{ ../enc }">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="x" type="xs:string" dfdl:initiator="X:"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="e" type="xs:int"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_probe_rewind_1" root="rewind" model="s25"
                       description="anyEmpty, infix: a failed optional nested complex element restores the input position so the next element still parses.">
    <tdml:document>1,7</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:rewind xmlns:ex="http://example.com">
          <a>1</a>
          <w>7</w>
        </ex:rewind>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_probe_end_of_data_1" root="endOfDataArray" model="s26"
                       description="trailingEmpty, infix, no terminator: a separator at the very end of the data after an array of complex items is accepted as a trailing empty occurrence, which trailingEmpty allows; the end of the data is not treated as a missing delimiter.">
    <tdml:document>1,X:a,X:b,</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:endOfDataArray xmlns:ex="http://example.com">
          <a>1</a>
          <c><x>a</x></c>
          <c><x>b</x></c>
        </ex:endOfDataArray>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_probe_encoding_scope_1" root="encodingScope" model="s27"
                       description="An omitted optional complex child with an expression-valued encoding does not change how the sequence's delimiters are checked.">
    <tdml:document>UTF-8,1,,3</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:encodingScope xmlns:ex="http://example.com">
          <enc>UTF-8</enc>
          <a>1</a>
          <e>3</e>
        </ex:encodingScope>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s28" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:element name="discriminatedAbsent">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="infix"
                     dfdl:separatorSuppressionPolicy="anyEmpty">
          <xs:element name="a" type="xs:string"/>
          <xs:element name="b" type="xs:int" minOccurs="0">
            <xs:annotation>
              <xs:appinfo source="http://www.ogf.org/dfdl/">
                <dfdl:discriminator testKind="pattern" testPattern=","/>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="c" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_discriminated_absent_1" root="discriminatedAbsent" model="s28"
                       description="anyEmpty, infix: an optional element whose discriminator matches but whose value is empty gives a parse error, not an engine abort.">
    <tdml:document>x,,y</tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>Unable to parse xs:int from empty string</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s29" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:element name="discriminatedTrailing">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorPosition="infix"
                     dfdl:separatorSuppressionPolicy="trailingEmpty">
          <xs:element name="a" type="xs:string"/>
          <xs:element name="b" type="xs:string" minOccurs="0">
            <xs:annotation>
              <xs:appinfo source="http://www.ogf.org/dfdl/">
                <dfdl:discriminator test="{ fn:true() }"/>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:unparserTestCase name="test_sep_unparse_discriminated_trailing_1"
                         root="discriminatedTrailing" model="s29" roundTrip="none"
                         description="Unparse, trailingEmpty: a trailing empty optional element that has a discriminator is suppressed with its separator like any other, since discriminators are not used when unparsing.">
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:discriminatedTrailing xmlns:ex="http://example.com">
          <a>x</a>
          <b></b>
        </ex:discriminatedTrailing>
      </tdml:dfdlInfoset>
    </tdml:infoset>
    <tdml:document>x</tdml:document>
  </tdml:unparserTestCase>

  <tdml:defineSchema name="s30" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:element name="positionalOptionalComplex">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix"
                     dfdl:separatorSuppressionPolicy="trailingEmpty" dfdl:terminator="%NL;">
          <xs:element name="foo" type="xs:string"/>
          <xs:element name="c" minOccurs="0">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="x" type="xs:string" dfdl:initiator="C:"/>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="d" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_positional_optional_complex_1"
                       root="positionalOptionalComplex" model="s30"
                       description="trailingEmpty, prefix: an absent optional complex element that is followed by a required element is rejected when its separator is missing, since only trailing occurrences may drop their separators.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/D%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>must keep its separator</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_positional_optional_complex_2"
                       root="positionalOptionalComplex" model="s30"
                       description="trailingEmpty, prefix: an absent optional complex element that is followed by a required element parses when its separator is still present, leaving the element absent.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1//D%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:positionalOptionalComplex xmlns:ex="http://example.com">
          <foo>1</foo>
          <d>D</d>
        </ex:positionalOptionalComplex>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_positional_optional_complex_3"
                       root="positionalOptionalComplex" model="s30"
                       description="trailingEmpty, prefix: a present optional complex element that is followed by a required element parses.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/C:X/D%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:positionalOptionalComplex xmlns:ex="http://example.com">
          <foo>1</foo>
          <c><x>X</x></c>
          <d>D</d>
        </ex:positionalOptionalComplex>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:defineSchema name="s31" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format ref="ex:GeneralFormat" lengthKind="delimited"/>

    <xs:element name="midOptionalInt">
      <xs:complexType>
        <xs:sequence dfdl:separator="," dfdl:separatorSuppressionPolicy="trailingEmpty">
          <xs:element name="a" type="xs:string" dfdl:lengthKind="explicit" dfdl:length="1"/>
          <xs:element name="b" type="xs:int" minOccurs="0" dfdl:lengthKind="explicit" dfdl:length="1"/>
          <xs:element name="c" type="xs:string" dfdl:lengthKind="explicit" dfdl:length="1"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>
  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_absent_mid_optional_1"
                       root="midOptionalInt" model="s31"
                       description="trailingEmpty: an absent optional int that is followed by a required element is rejected when its separator is missing, since only trailing occurrences may drop their separators.">
    <tdml:document>a,c</tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>must keep its separator</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_absent_mid_optional_2"
                       root="midOptionalInt" model="s31"
                       description="trailingEmpty: with explicit length 1 the optional int consumes the second comma as its content and fails, so it is absent without its own separator and the parse is rejected.">
    <tdml:document>a,,c</tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>must keep its separator</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_absent_mid_optional_3"
                       root="midOptionalInt" model="s31"
                       description="trailingEmpty: a present optional int followed by a required element parses.">
    <tdml:document>a,1,c</tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:midOptionalInt xmlns:ex="http://example.com">
          <a>a</a>
          <b>1</b>
          <c>c</c>
        </ex:midOptionalInt>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_absent_mid_optional_4"
                       root="midOptionalInt" model="s31"
                       description="trailingEmpty: a non-numeric value in the optional int position makes the int fail to parse and be absent without its separator, so the parse is rejected.">
    <tdml:document>a,Z,x</tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>must keep its separator</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

</tdml:testSuite>
