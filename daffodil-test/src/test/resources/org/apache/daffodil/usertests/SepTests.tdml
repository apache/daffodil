      <tdml:error>trailingEmptyStrict</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_strict_8" root="postfixOptional" model="s19"
                       description="trailingEmptyStrict, postfix: input that is only a separator is rejected as a trailing empty element.">
