        </ex:complex>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_any_4" root="complex" model="s17"
                       implementations="daffodil"
                       description="anyEmpty, complex elements: the empty middle occurrence may be omitted with its separator.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/3%LF;</tdml:documentPart>
    </tdml:document>
