      <tdml:documentPart type="text" replaceDFDLEntities="true">/1//3%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:infoset>
      <tdml:dfdlInfoset>
        <ex:complex xmlns:ex="http://example.com">
          <one><value>1</value></one>
          <three><value>3</value></three>
        </ex:complex>
      </tdml:dfdlInfoset>
    </tdml:infoset>
  </tdml:parserTestCase>

  <tdml:parserTestCase name="test_sep_ssp_trailing_4" root="complex" model="s15"
                       implementations="daffodil"
                       description="trailingEmpty, complex elements: omitting a non-trailing empty occurrence together with its separator is rejected.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1/3%LF;</tdml:documentPart>
    </tdml:document>
    <tdml:errors>
      <tdml:error>Parse Error</tdml:error>
      <tdml:error>Non-trailing zero length occurrences</tdml:error>
      <tdml:error>may not be omitted</tdml:error>
      <tdml:error>separatorSuppressionPolicy='trailingEmpty'</tdml:error>
    </tdml:errors>
  </tdml:parserTestCase>

<tdml:defineSchema name="s16" elementFormDefault="unqualified">
    <xs:include schemaLocation="/org/apache/daffodil/xsd/DFDLGeneralFormat.dfdl.xsd"/>
    <dfdl:format
        ref="ex:GeneralFormat"
        emptyValueDelimiterPolicy="none"
        lengthKind="delimited"
        separatorPosition="infix"
        separatorSuppressionPolicy="never"
    />

    <xs:element name="simple">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix" dfdl:terminator="%NL;">
            <xs:element name="one" type="xs:string"  minOccurs="0"/>
            <xs:element name="two" type="xs:string" minOccurs="0">
              <xs:annotation>
                <xs:appinfo source="http://www.ogf.org/dfdl/">
                  <dfdl:discriminator test="{. eq '2'}"/>
                </xs:appinfo>
              </xs:annotation>
            </xs:element>
            <xs:element name="three" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:element name="complex">
      <xs:complexType>
        <xs:sequence dfdl:separator="/" dfdl:separatorPosition="prefix" dfdl:terminator="%NL;">
            <xs:element name="one" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="two" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string">
                    <xs:annotation>
                      <xs:appinfo source="http://www.ogf.org/dfdl/">
                        <dfdl:discriminator test="{. eq '2'}"/>
                      </xs:appinfo>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="three" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:element>


  </tdml:defineSchema>

  <tdml:parserTestCase name="test_sep_ssp_never_13" root="simple" model="s16"
                       implementations="daffodil"
                       description="never, simple elements: an empty middle occurrence that keeps its separator parses, with the middle element absent.">
    <tdml:document>
      <tdml:documentPart type="text" replaceDFDLEntities="true">/1//3%LF;</tdml:documentPart>
    </tdml:document>
